INS_LOC "ddr/Gowin_PLL_inst/u_pll/PLL_inst" PLL_L[0];
INS_LOC "ddr/u_ddr3/gw3_top/u_ddr_phy_top/u_dll" DDRDLLM_BL;
INS_LOC "ddr/u_ddr3/gw3_top/u_ddr_phy_top/fclkdiv" LEFTSIDE[4];

// r2：真正时钟保留专用CLK路由；四lane有效位仅驱动本lane，禁止再占全局时钟线。
CLOCK_LOC "system_clk" BUFG = CLK;
CLOCK_LOC "engine/render/modal/g_lane[0].math/valid[0]" LOCAL_CLOCK;
CLOCK_LOC "engine/render/modal/g_lane[0].math/valid[1]" LOCAL_CLOCK;
CLOCK_LOC "engine/render/modal/g_lane[0].math/valid[2]" LOCAL_CLOCK;
