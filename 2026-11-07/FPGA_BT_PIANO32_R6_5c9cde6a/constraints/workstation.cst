CLOCK_LOC "engine/render/modal/g_lane[3].math/valid[3]" LOCAL_CLOCK;
CLOCK_LOC "engine/render/modal/g_lane[3].math/valid[4]" LOCAL_CLOCK;
CLOCK_LOC "engine/render/modal/pre_valid_2[3]" LOCAL_CLOCK;

// r3：PCM宽输出总使能为数据控制，保留本地网络，避免自动占用LW。
CLOCK_LOC "engine/render/pcm_output_enable" LOCAL_CLOCK;

// r4：模态任务有效为数据使能，不占用全局长线；实际匹配由网表核查。
CLOCK_LOC "engine/render/modal/task_valid_Z" LOCAL_CLOCK;

CLOCK_LOC "resources/query_snapshot_enable" LOCAL_CLOCK;
CLOCK_LOC "resources/reply_cache_enable" LOCAL_CLOCK;
CLOCK_LOC "engine/render/generation_output_enable" LOCAL_CLOCK;
CLOCK_LOC "engine/render/modal/accept" LOCAL_CLOCK;
CLOCK_LOC "engine/render/modal/return_accepted" LOCAL_CLOCK;

// SUG1018 §2.3：仅移动WLOADN末级50MHz寄存器，增加真实短路径延迟，不切hold。
// 第八轮Q到左侧DQS长达5.669ns、D最短仅1.408ns；向R100C0接收区移动，兼顾出端setup和入端hold。
INS_LOC "ddr/u_ddr3/gw3_top/u_ddr_phy_top/wloadn_3_s0" R[90:110]C[12:24];
// 板载参考仍是实际50MHz时钟；要求专用全局分支，禁止改成数据本地路由。
CLOCK_LOC "sys_clk_d" BUFG = CLK;
// 网表核对：该LUT输出仅驱动548 RESET + 32 SET，保持复位语义，普通本地数据控制。
CLOCK_LOC "resources/memory/n86_11" LOCAL_CLOCK;

// 第九轮实际hold -1.984ns：自动放置把100MHz源拖到R74C12，至R90C12只有0.477ns线延迟。
// 保持WLOADN靠近DQS；单独拉开只有两个负载的源，避免二者一起移动后短路径仍在。
// 不改变时钟、逻辑和hold要求；新实现必须同时检查该源的所有setup/hold。
// 第十轮该源实际R24C80，2.205ns route仍少0.250ns hold；只继续拉开源到目的距离。
INS_LOC "ddr/u_ddr3/gw3_top/u_ddr_phy_top/ddr_init_internal_r_s0" R[20:24]C[132:140];

// 第十四轮唯一真实Setup -0.027ns：hold_i在R81C6、反相LUT在R81C3，目标DQS在R100C0。
// 只将该寄存器/反相LUT放到对应DQS近邻，缩短2.736ns数据路径；时钟/Setup/Hold要求不变。
INS_LOC "ddr/u_ddr3/gw3_top/u_ddr_phy_top/u_ddr_init/hold_gen[1].hold_i_s0" R[96:104]C[2:8];
INS_LOC "ddr/u_ddr3/gw3_top/u_ddr_phy_top/u_ddr_init/hold_Z_1_s" R[96:104]C[2:8];

// r5: actual DQS HOLD setup violations; keep all senders near each fixed DQS.
INS_LOC "ddr/u_ddr3/gw3_top/u_ddr_phy_top/u_ddr_init/read_rclksel_conf_0_s0" R[70:76]C[2:8];
INS_LOC "ddr/u_ddr3/gw3_top/u_ddr_phy_top/u_ddr_init/hold_gen[0].hold_i_s0" R[70:76]C[2:8];
INS_LOC "ddr/u_ddr3/gw3_top/u_ddr_phy_top/u_ddr_init/hold_Z_0_s" R[70:76]C[2:8];
INS_LOC "ddr/u_ddr3/gw3_top/u_ddr_phy_top/u_ddr_init/read_rclksel_conf_1_s0" R[96:104]C[2:8];
INS_LOC "ddr/u_ddr3/gw3_top/u_ddr_phy_top/u_ddr_init/read_rclksel_conf_2_s0" R[88:94]C[2:8];
INS_LOC "ddr/u_ddr3/gw3_top/u_ddr_phy_top/u_ddr_init/hold_gen[2].hold_i_s0" R[88:94]C[2:8];
INS_LOC "ddr/u_ddr3/gw3_top/u_ddr_phy_top/u_ddr_init/hold_Z_2_s" R[88:94]C[2:8];
INS_LOC "ddr/u_ddr3/gw3_top/u_ddr_phy_top/u_ddr_init/read_rclksel_conf_3_s0" R[61:67]C[2:8];
INS_LOC "ddr/u_ddr3/gw3_top/u_ddr_phy_top/u_ddr_init/hold_gen[3].hold_i_s0" R[63:65]C[2:4];
INS_LOC "ddr/u_ddr3/gw3_top/u_ddr_phy_top/u_ddr_init/hold_Z_3_s" R[63:65]C[2:4];
CLOCK_LOC "engine/render/modal/damping_pipe_capture" LOCAL_CLOCK;
CLOCK_LOC "resources/status_snapshot_enable" LOCAL_CLOCK;
CLOCK_LOC "display/service/telemetry_capture_enable" LOCAL_CLOCK;
// Data write enable for the packed timbre table; not a generated clock.
CLOCK_LOC "player/write_timbres" LOCAL_CLOCK;
// The reduction valid is a data enable, not a clock.
CLOCK_LOC "engine/render/modal/reduction_valid" LOCAL_CLOCK;
// Keep the two diagnostic release stages together; let the shared global reset source place freely.
// Only the exact synchronizer CLEAR ingress is excepted; all functional reset loads remain timed.
INS_LOC "hardware_monitor/mem_reset_release_0_s0" R[36:37]C[62:63];
INS_LOC "hardware_monitor/mem_reset_release_1_s0" R[36:37]C[62:63];

// HC-05独立UART；只供蓝牙集成候选合入，未用于当前原生r7回归工程。
// D20输入接HC-05 TXD；C20输出接HC-05 RXD。信号电平为3.3V。
// 31005底板：J13-36 / J13-35；不得与SDRAM扩展板同时使用该排针。
IO_LOC "bt_rx_i" D20;
IO_PORT "bt_rx_i" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "bt_tx_o" C20;
IO_PORT "bt_tx_o" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 BANK_VCCIO=3.3;
