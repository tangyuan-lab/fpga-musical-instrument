// Tang Mega 60K + NEO Dock 31004/Rev 1.4：片内 ADC + PT8211 + PMOD0 + HDMI TX。
IO_LOC "sys_clk" V22;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "sys_rst_n" Y12;
IO_PORT "sys_rst_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;

IO_LOC "uart_tx_o" U15;
IO_PORT "uart_tx_o" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 BANK_VCCIO=3.3;

IO_LOC "hp_bck" Y17;
IO_LOC "hp_ws" AB17;
IO_LOC "hp_din" AA16;
IO_LOC "pa_en" AB16;
IO_PORT "hp_bck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "hp_ws" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "hp_din" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "pa_en" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "led_n[0]" P19;
IO_LOC "led_n[1]" R19;
IO_LOC "led_n[2]" T21;
IO_LOC "led_n[3]" U21;
IO_LOC "led_n[4]" P16;
IO_LOC "led_n[5]" R17;
IO_LOC "led_n[6]" R18;
IO_LOC "led_n[7]" T18;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led_n[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led_n[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led_n[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led_n[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led_n[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led_n[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// HDMI J29 的三路数据差分对和一路时钟差分对。
IO_LOC "tmds_p[0]" J14,H14;
IO_LOC "tmds_p[1]" J15,H15;
IO_LOC "tmds_p[2]" K17,J17;
IO_LOC "tmds_clk_p" G15,G16;
IO_LOC "hpd_en" K13;
IO_PORT "tmds_p[0]" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_PORT "tmds_p[1]" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_PORT "tmds_p[2]" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_PORT "tmds_clk_p" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_PORT "hpd_en" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=12 BANK_VCCIO=3.3;

// 与 Sipeed 官方 60K cam_dvi 工程相同，将 TMDS PLL 放在右侧 PLL_R[0]。
INS_LOC "video_clocks/pll" PLL_R[0];
