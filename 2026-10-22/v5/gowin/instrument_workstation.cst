// Tang Mega 60K + NEO Dock 31004/Rev 1.4 比赛统一工程。
// HDMI、PT8211、PMOD0 LED 和 PMOD1 MCP3208 沿用已验证约束；
// 板载 USB-C UART 增加 V14 接收，AB13/AA13 用作模式和实时音色按键。

IO_LOC "sys_clk" V22;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "sys_rst_n" Y12;
IO_PORT "sys_rst_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;

IO_LOC "uart_tx_o" U15;
IO_PORT "uart_tx_o" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "uart_rx_i" V14;
IO_PORT "uart_rx_i" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// 外部串口屏 UART：C18 为 FPGA TX，C19 为 FPGA RX。
// 若串口屏 TX 为 5V 电平，进入 FPGA 前必须转换或分压到 3.3V。
IO_LOC "screen_tx_o" C18;
IO_PORT "screen_tx_o" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "screen_rx_i" C19;
IO_PORT "screen_rx_i" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC "mode_key_n" AB13;
IO_PORT "mode_key_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
IO_LOC "timbre_key_n" AA13;
IO_PORT "timbre_key_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;

IO_LOC "hp_bck" Y17;
IO_LOC "hp_ws" AB17;
IO_LOC "hp_din" AA16;
IO_LOC "pa_en" AB16;
IO_PORT "hp_bck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "hp_ws" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "hp_din" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "pa_en" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// PMOD0 LED2..LED7，低电平点亮；IO0/IO1 当前未使用，串口屏位于 C18/C19。
IO_LOC "led_n[0]" T21;
IO_LOC "led_n[1]" U21;
IO_LOC "led_n[2]" P16;
IO_LOC "led_n[3]" R17;
IO_LOC "led_n[4]" R18;
IO_LOC "led_n[5]" T18;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led_n[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led_n[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led_n[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led_n[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// 工作站SPI约束由 pressure_inputs.spi_pins 生成，采集板从左到右为SCLK/MISO/MOSI/CS。
// 第1块：sclk=AA19, miso=AA20, mosi=AB21, cs_n=Y21。
// 第2块：sclk=AB20, miso=AA21, mosi=AB22, cs_n=Y22。
// 改脚号同时保留MISO输入、MOSI/SCLK/CS输出的3.3V电气设置。
IO_LOC "mcp0_sclk" AA19;
IO_LOC "mcp1_sclk" AB20;
IO_LOC "mcp0_miso" AA20;
IO_LOC "mcp1_miso" AA21;
IO_LOC "mcp0_mosi" AB21;
IO_LOC "mcp1_mosi" AB22;
IO_LOC "mcp0_cs_n" Y21;
IO_LOC "mcp1_cs_n" Y22;
IO_PORT "mcp0_sclk" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 BANK_VCCIO=3.3;
IO_PORT "mcp1_sclk" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 BANK_VCCIO=3.3;
IO_PORT "mcp0_miso" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=OFF BANK_VCCIO=3.3;
IO_PORT "mcp1_miso" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=OFF BANK_VCCIO=3.3;
IO_PORT "mcp0_mosi" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 BANK_VCCIO=3.3;
IO_PORT "mcp1_mosi" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 BANK_VCCIO=3.3;
IO_PORT "mcp0_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 BANK_VCCIO=3.3;
IO_PORT "mcp1_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 BANK_VCCIO=3.3;

// HDMI J29 三路数据差分对、一路时钟差分对及 HPD 控制。
IO_LOC "tmds_p[0]" J14,H14;
IO_LOC "tmds_p[1]" J15,H15;
IO_LOC "tmds_p[2]" K17,J17;
IO_LOC "tmds_clk_p" G15,G16;
IO_LOC "hpd_en" K13;
IO_PORT "tmds_p[0]" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_PORT "tmds_p[1]" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_PORT "tmds_p[2]" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_PORT "tmds_clk_p" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_PORT "hpd_en" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=12 BANK_VCCIO=3.3;

INS_LOC "video_clocks/pll" PLL_R[0];
