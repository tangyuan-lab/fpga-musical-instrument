// Tang Mega NEO Dock 60K / 31004 Rev.1.4
// J5 RGB LCD：底板已把 R0/R1、G0/G1、B0/B1 接地，使用 RGB666。
// J6 CTP：SCL/SDA 接在板上已有 5.1K 上拉。

IO_LOC "sys_clk" V22;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "sys_rst_n" Y12;
IO_PORT "sys_rst_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;

// J5 pin 7..12: R2..R7
IO_LOC "lcd_r[0]" G18;
IO_LOC "lcd_r[1]" G17;
IO_LOC "lcd_r[2]" H22;
IO_LOC "lcd_r[3]" J22;
IO_LOC "lcd_r[4]" K22;
IO_LOC "lcd_r[5]" K21;
// J5 pin 15..20: G2..G7
IO_LOC "lcd_g[0]" K18;
IO_LOC "lcd_g[1]" L21;
IO_LOC "lcd_g[2]" M21;
IO_LOC "lcd_g[3]" M22;
IO_LOC "lcd_g[4]" N22;
IO_LOC "lcd_g[5]" L18;
// J5 pin 23..28: B2..B7
IO_LOC "lcd_b[0]" M18;
IO_LOC "lcd_b[1]" N19;
IO_LOC "lcd_b[2]" N18;
IO_LOC "lcd_b[3]" K16;
IO_LOC "lcd_b[4]" L16;
IO_LOC "lcd_b[5]" M20;

// J5 pin 30/32/33/34: DCLK/HSYNC/VSYNC/DE
IO_LOC "lcd_pclk" L19;
IO_LOC "lcd_hsync" N20;
IO_LOC "lcd_vsync" L15;
IO_LOC "lcd_de" L14;

IO_PORT "lcd_r[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_r[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_r[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_r[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_r[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_r[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_g[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_g[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_g[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_g[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_g[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_g[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_b[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_b[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_b[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_b[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_b[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_b[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_pclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_hsync" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_vsync" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_de" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// J0/BTB 与 J5 背光驱动 LP3320 的 LCD_DPI_BL 网络。
IO_LOC "lcd_bl" P20;
IO_PORT "lcd_bl" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// J6 pin 1/4/5/6: CTP_RST/INT/SDA/SCL
IO_LOC "ctp_rst" T15;
IO_LOC "ctp_int" T16;
IO_LOC "ctp_sda" U16;
IO_LOC "ctp_scl" W16;
IO_PORT "ctp_rst" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// ctp_int 为输入，不能指定 DRIVE；SDA/SCL 由 RTL 开漏控制，输出时只拉低。
IO_PORT "ctp_int" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "ctp_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "ctp_scl" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// PMOD0 八灯，低电平点亮。
IO_LOC "led_n[0]" P19;
IO_LOC "led_n[1]" R19;
IO_LOC "led_n[2]" T21;
IO_LOC "led_n[3]" U21;
IO_LOC "led_n[4]" P16;
IO_LOC "led_n[5]" R17;
IO_LOC "led_n[6]" R18;
IO_LOC "led_n[7]" T18;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led_n[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led_n[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led_n[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led_n[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led_n[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led_n[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
